# Copy to .env (git-ignored) and fill in. Never commit .env: this repo is public.

# Image server on the GPU host (tools/gpu-host): start.cmd prints this line.
D2_IMAGE_SERVER=http://<gpu-host-ip>:1234

# Hugging Face read token for TRELLIS.2 on ZeroGPU (huggingface.co/settings/tokens,
# a free account, token type "Read").
HF_TOKEN=
